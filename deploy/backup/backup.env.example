# /etc/tension/backup.env  —  chmod 600, propietario: usuario que ejecuta la copia
#
# Misma cadena que DATABASE_URL del .env de Django (postgres://usuario:clave@host:5432/bd)
DATABASE_URL=postgres://tension:CAMBIAR@localhost:5432/tension

# Debe coincidir con MEDIA_ROOT del .env de Django
MEDIA_ROOT=/var/www/tension/media

# Destino local de las copias (idealmente en otro disco/volumen)
BACKUP_DIR=/var/backups/tension

# Días que se conservan las copias locales
BACKUP_KEEP_DAYS=14

# (Opcional) Copiar también el .env de Django (contiene secretos)
ENV_FILE=/var/www/tension/.env

# (Opcional, recomendado) Remoto rclone para copia externa, p.ej. Backblaze B2,
# Hetzner Storage Box, Google Drive...  Configúralo antes con `rclone config`.
# RCLONE_REMOTE=b2:egalvez-backups/tension
RCLONE_REMOTE=
